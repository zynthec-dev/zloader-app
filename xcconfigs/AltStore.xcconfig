#include "../Build.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(MAIN_BUNDLE_IDENTIFIER)

// for ios14 and above swift runtime is included
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = NO

#include? "../local.xcconfig"

// zLoader embedded tunnel requires a provisioned Network Extension entitlement.
CODE_SIGN_ENTITLEMENTS = zLoader/Host.entitlements

// Preserve storyboard class module identity only for the host app.
PRODUCT_MODULE_NAME = SideStore
