+    /// Fail before signing/installing if a discovered child retained the old
+    /// host ID. Each component must still have its own authorized profile.
+    public static func validateIdentifiers(in root: URL) throws {
+        let components = try componentURLs(in: root)
+        var seen = Set<String>()
+        var hostID: String?
+        for component in components {
+            let rootPlist = component.appendingPathComponent("Info.plist")
+            let plistURL = FileManager.default.fileExists(atPath: rootPlist.path)
+                ? rootPlist : component.appendingPathComponent("Contents/Info.plist")
+            let data = try Data(contentsOf: plistURL)
+            guard let info = try PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],
+                  let identifier = info["CFBundleIdentifier"] as? String, !identifier.isEmpty,
+                  seen.insert(identifier).inserted else {
+                throw CocoaError(.propertyListReadCorrupt, userInfo: [NSLocalizedDescriptionKey:
+                    "Unreadable or duplicate bundle identifier in '\(component.lastPathComponent)'."])
+            }
+            if let hostID {
+                guard identifier.hasPrefix(hostID + ".") else {
+                    throw CocoaError(.propertyListReadCorrupt, userInfo: [NSLocalizedDescriptionKey:
+                        "Embedded bundle ID '\(identifier)' must start with '\(hostID).'."])
+                }
+            } else {
+                hostID = identifier
+            }
+        }
     }
 
