+import Foundation
+
+/// Bundle relationships used by profile preparation and signing, independently of removal UI.
+public enum BundleSigningLayout {
+    /// Cached/custom metadata must not replace the source graph with a prior
+    /// team's resolved identities. Resign owns these writes for the whole graph.
+    public static func preparationMetadata(_ metadata: [String: any Sendable]) -> [String: any Sendable] {
+        var metadata = metadata
+        metadata.removeValue(forKey: "CFBundleIdentifier")
+        metadata.removeValue(forKey: "WKCompanionAppBundleIdentifier")
+        if var extensionInfo = metadata["NSExtension"] as? [String: any Sendable],
+           var attributes = extensionInfo["NSExtensionAttributes"] as? [String: any Sendable] {
+            attributes.removeValue(forKey: "WKAppBundleIdentifier")
+            extensionInfo["NSExtensionAttributes"] = attributes
+            metadata["NSExtension"] = extensionInfo
+        }
+        return metadata
+    }
+
+    public static func componentURLs(in root: URL) throws -> [URL] {
+        let root = root.resolvingSymlinksInPath()
+        var components: [URL] = []
+        var visited = Set<URL>()
+        func visit(_ bundle: URL) throws {
+            let bundle = bundle.resolvingSymlinksInPath()
+            guard bundle == root || bundle.path.hasPrefix(root.path + "/") else {
+                throw CocoaError(.fileReadNoPermission)
+            }
+            guard visited.insert(bundle).inserted else { return }
+            components.append(bundle)
+            for (folder, suffix) in [("PlugIns", "appex"), ("Watch", "app")] {
+                let directory = bundle.appendingPathComponent(folder)
+                guard FileManager.default.fileExists(atPath: directory.path) else { continue }
+                let children = try FileManager.default.contentsOfDirectory(
+                    at: directory, includingPropertiesForKeys: nil, options: [.skipsHiddenFiles]
+                ).filter { $0.pathExtension.lowercased() == suffix }
+                    .sorted { $0.lastPathComponent < $1.lastPathComponent }
+                for child in children { try visit(child) }
+            }
+        }
+        try visit(root)
+        return components
+    }
+
+    public static func rebasedIdentifier(_ identifier: String, from original: String, to resolved: String) throws -> String {
+        guard identifier == original || identifier.hasPrefix(original + ".") else {
+            throw CocoaError(.propertyListReadCorrupt, userInfo: [NSLocalizedDescriptionKey:
+                "Component bundle ID '\(identifier)' is outside its parent '\(original)'."])
+        }
+        return resolved + identifier.dropFirst(original.count)
+    }
+
+    /// Exact profile-resolved identities also handle custom IDs and legacy Watch extensions.
+    public static func rewriting(_ info: [String: Any], identities: [String: String]) throws -> [String: Any] {
+        var info = info
+        guard let original = info["CFBundleIdentifier"] as? String,
+              let resolved = identities[original] else {
+            throw CocoaError(.propertyListReadCorrupt, userInfo: [NSLocalizedDescriptionKey:
+                "The component has no profile-resolved bundle identifier."])
+        }
+        func reference(_ value: String) throws -> String {
+            if let mapped = identities[value] { return mapped }
+            if identities.values.contains(value) { return value }
+            throw CocoaError(.propertyListReadCorrupt, userInfo: [NSLocalizedDescriptionKey:
+                "Watch bundle reference '\(value)' does not identify a packaged component."])
+        }
+        info["CFBundleIdentifier"] = resolved
+        if let companion = info["WKCompanionAppBundleIdentifier"] as? String {
+            info["WKCompanionAppBundleIdentifier"] = try reference(companion)
+        }
+        if var extensionInfo = info["NSExtension"] as? [String: Any],
+           var attributes = extensionInfo["NSExtensionAttributes"] as? [String: Any],
+           let watch = attributes["WKAppBundleIdentifier"] as? String {
+            attributes["WKAppBundleIdentifier"] = try reference(watch)
+            extensionInfo["NSExtensionAttributes"] = attributes
+            info["NSExtension"] = extensionInfo
+        }
+        if let tasks = info["BGTaskSchedulerPermittedIdentifiers"] as? [String], original != resolved {
+            var seen = Set<String>()
+            info["BGTaskSchedulerPermittedIdentifiers"] = tasks.map { task -> String in
+                if task == resolved || task.hasPrefix(resolved + ".") { return task }
+                if task == original || task.hasPrefix(original + ".") {
+                    return resolved + task.dropFirst(original.count)
+                }
+                return task
+            }.filter { seen.insert($0).inserted }
+        }
+        return info
+    }
+}
