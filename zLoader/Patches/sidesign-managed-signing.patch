+    public func changedFeatures(comparedTo current: AppID) -> [Feature: String] {
+        features.filter { feature, value in
+            let requested = value.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+            let existing = current.features[feature]?.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() ?? "false"
+            return requested != existing
