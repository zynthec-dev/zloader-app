@@ -0,0 +1,15 @@
+import Foundation
+
+/// Sidecar requests are input metadata, never proof of Apple authorization.
+public enum EntitlementMetadata {
+    public static func mergedXML(signature: String, sidecar: Data?) -> String {
+        guard let sidecar,
+              var requests = try? PropertyListSerialization.propertyList(from: sidecar, format: nil) as? [String: Any] else { return signature }
+        if let data = signature.data(using: .utf8),
+           let signed = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] {
+            requests.merge(signed) { _, actual in actual }
+        }
+        guard let xml = try? PropertyListSerialization.data(fromPropertyList: requests, format: .xml, options: 0) else { return signature }
+        return String(data: xml, encoding: .utf8) ?? signature
+    }
+}
