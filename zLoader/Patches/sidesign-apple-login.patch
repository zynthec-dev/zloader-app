diff --git a/Sources/DeveloperPortal/AppleLoginCompatibility.swift b/Sources/DeveloperPortal/AppleLoginCompatibility.swift
new file mode 100644
--- /dev/null
+++ b/Sources/DeveloperPortal/AppleLoginCompatibility.swift
@@ -0,0 +1,69 @@
+import Foundation
+
+// Adapted from SideStore/SideSign PR #5 (NiceAesth) and SideStore commit
+// 34f61f2. Keep the Android ADI identity scoped to GrandSlam endpoints;
+// Apple's /auth/verify endpoints still require the original anisette identity.
+enum AppleLoginCompatibility {
+    @TaskLocal static var pushedCodeHandled = false
+    @TaskLocal static var useWindowsIdentity = false
+
+    enum Phase: String, Sendable {
+        case initialization = "init"
+        case proof = "complete"
+        case appTokens = "apptokens"
+        case other
+    }
+
+    struct HTTPFailure: LocalizedError, Sendable {
+        let statusCode: Int
+        let phase: Phase
+        let retryAfter: TimeInterval?
+
+        var errorDescription: String? {
+            let step: String
+            switch phase {
+            case .initialization: step = "starting sign-in"
+            case .proof: step = "verifying sign-in"
+            case .appTokens: step = "requesting the app token"
+            case .other: step = "contacting Apple"
+            }
+            return "Apple returned HTTP \(statusCode) while \(step). Please wait a moment and try again."
+        }
+    }
+
+    // One fresh SRP attempt, scoped to this login, only after an HTTP 503
+    // at initialization or proof. Never replay a proof or a verification code.
+    static func retryHandshake503<Result: Sendable>(after error: any Error,
+                                       pause: @Sendable (TimeInterval) async throws -> Void = { try await Task.sleep(nanoseconds: UInt64($0 * 1_000_000_000)) },
+                                       attempt: @Sendable () async throws -> Result) async throws -> Result {
+        guard let failure = error as? HTTPFailure, failure.statusCode == 503,
+              (failure.phase == .initialization || failure.phase == .proof), !useWindowsIdentity else { throw error }
+        if let retryAfter = failure.retryAfter,
+           !retryAfter.isFinite || retryAfter < 0 || retryAfter > 30 { throw error }
+        let seconds = max(5, failure.retryAfter ?? 5)
+        try await pause(seconds)
+        try Task.checkCancellation()
+        return try await $useWindowsIdentity.withValue(true) {
+            try await attempt()
+        }
+    }
+
+    private static let androidClientInfo = "<Pixel 7> <Android;14;UQ1A.240205.002> <com.apple.AuthKit/1 (com.apple.akd/1.0)>"
+
+    // Windows descriptor reported working where the Android descriptor yields
+    // non-plist 503 responses: Dadoum/anisette-v3-server issue #61 (2026-10-16).
+    private static let windowsClientInfo = "<PC> <Windows;6.2(0,0);9200> <com.apple.AuthKit/1 (com.apple.akd/1.0)>"
+
+    static func clientInfo(for url: URL, anisetteClientInfo: String) -> String {
+        if url.scheme == "https", url.host == "gsa.apple.com", url.path.hasPrefix("/grandslam/") {
+            return useWindowsIdentity ? windowsClientInfo : androidClientInfo
+        }
+        return anisetteClientInfo
+    }
+
+    static func authenticationType(response: [String: any Sendable], status: [String: any Sendable]?) -> String? {
+        (status?["au"] as? String)
+            ?? (response["au"] as? String)
+            ?? ((status?["hsc"] as? Int) == 409 ? "pushedCode" : nil)
+    }
+}
