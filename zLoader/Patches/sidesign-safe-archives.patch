@@ -0,0 +1,18 @@
+import Foundation
+
+/// Keep archive writes inside their extraction root, including existing symlinks.
+public enum ArchivePathPolicy {
+    public static func destination(for filename: String, in directory: URL) throws -> URL {
+        guard !filename.isEmpty, !filename.hasPrefix("/"), !filename.contains("\\"),
+              !filename.contains("\0"), !filename.split(separator: "/").contains("..") else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        let root = directory.standardizedFileURL.resolvingSymlinksInPath()
+        let target = root.appendingPathComponent(filename).standardizedFileURL.resolvingSymlinksInPath()
+        let prefix = root.path.hasSuffix("/") ? root.path : root.path + "/"
+        guard target.path.hasPrefix(prefix), target.path != root.path else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        return target
+    }
+}
