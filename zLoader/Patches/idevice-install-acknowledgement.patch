+
+// A response is an acknowledgement only after its error fields were checked.
+fn installation_progress(response: &Dictionary) -> Option<u64> {
+    if response.contains_key("Error") || response.contains_key("ErrorDescription") {
+        return None;
+    }
+    response.get("PercentComplete").and_then(|v| v.as_unsigned_integer()).or_else(|| {
+        response.get("Status").and_then(|v| v.as_string()).filter(|s| !s.is_empty()).map(|status| {
+            if status == "Complete" { 100 } else { 0 }
+        })
+    })
+}
+
+#[cfg(test)]
+mod zloader_installation_tests {
+    use super::*;
+    #[test]
+    fn acknowledges_status_without_percentage_but_never_errors() {
+        let mut response = Dictionary::new();
+        response.insert("Status".into(), "CreatingStagingDirectory".into());
+        assert_eq!(installation_progress(&response), Some(0));
+        response.insert("PercentComplete".into(), 42u64.into());
+        assert_eq!(installation_progress(&response), Some(42));
+        response.insert("Error".into(), "ApplicationVerificationFailed".into());
+        assert_eq!(installation_progress(&response), None);
+        response.remove("Error"); response.remove("PercentComplete");
+        response.insert("ErrorDescription".into(), "Rejected".into());
+        assert_eq!(installation_progress(&response), None);
+        response.clear();
+        assert_eq!(installation_progress(&response), None);
+        response.insert("Status".into(), "Complete".into());
+        assert_eq!(installation_progress(&response), Some(100));
+    }
+}
