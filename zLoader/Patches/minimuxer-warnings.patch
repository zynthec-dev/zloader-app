     private func resolveLocalVPNTunnel(from interfaces: Set<NetInfo>) async -> (tunnel: TunnelNetInfo?, candidatePeer: CandidatePeer?, isReachable: Bool) {
+        // An embedded provider supplies an exact routed peer. Do not discard it
+        // merely because route-table inference sees IPv6 or unrelated utuns.
+        if let configured = connectionConfigCache?.getOverrideTunnelPeerIp(), !configured.isEmpty {
+            let tunnels = Self.resolveCandidateTunnels(from: interfaces)
+            let owned = tunnels.first { $0.interfaceAddresses.v4.contains { $0.host == "10.7.1.1" } }
+            if let tunnel = owned ?? tunnels.first,
+               await tcpProbe(configured) {
+                return (tunnel, CandidatePeer(tunnel: tunnel, ip: configured, mask: "255.255.255.255"), true)
+            }
+        }
         // pick all candidate peer ips
         let candidates = Self.resolveCandidatePeers(from: interfaces)
         guard !candidates.isEmpty else { return (nil, nil, false) }
