+    public func createLockdownPairing(targetIP: String, hostName: String, hostID: String, systemBUID: String) async throws -> Data {
+        try await withFFIDispatch {
+            func check(_ error: UnsafeMutablePointer<IdeviceFfiError>?) throws {
+                if let error {
+                    defer { idevice_error_free(error) }
+                    throw IdeviceGatewayError(.serviceError, reason: self.getErrorMessage(from: error))
+                }
+            }
+            var device: OpaquePointer?
+            try self.withSockaddr(ip: targetIP, port: MinimuxerConstants.lockdowndPort) { address, length in
+                try address.withMemoryRebound(to: idevice_sockaddr.self, capacity: 1) {
+                    try check(idevice_new_tcp_socket($0, length, hostName, &device))
+                }
+            }
+            guard let device else { throw IdeviceGatewayError(.noConnection) }
+            // lockdownd_new consumes the device handle, including its error path.
+            var client: OpaquePointer?
+            try check(lockdownd_new(device, &client))
+            guard let client else { throw IdeviceGatewayError(.noConnection) }
+            defer { lockdownd_client_free(client) }
+            var pairing: OpaquePointer?
+            try check(lockdownd_pair(client, hostID, systemBUID, hostName, &pairing))
+            guard let pairing else { throw IdeviceGatewayError(.serviceError, reason: "Lockdown returned no pairing record") }
+            defer { idevice_pairing_file_free(pairing) }
+            var bytes: UnsafeMutablePointer<UInt8>?
+            var count: UInt = 0
+            try check(idevice_pairing_file_serialize(pairing, &bytes, &count))
+            guard let bytes else { throw IdeviceGatewayError(.serviceError, reason: "Lockdown returned no serialized record") }
+            defer { idevice_data_free(bytes, count) }
+            let serialized = Data(bytes: bytes, count: Int(count))
+            guard var record = try PropertyListSerialization.propertyList(from: serialized, options: [], format: nil) as? [String: Any] else {
+                throw IdeviceGatewayError(.serviceError, reason: "Lockdown returned an invalid pairing record")
+            }
+            // Native records can omit host-side device metadata. Read it from
+            // the real device; never synthesize a UDID or Wi-Fi identity.
+            for (recordKey, deviceKey) in [("UDID", "UniqueDeviceID"), ("WiFiMACAddress", "WiFiAddress")] where record[recordKey] == nil {
+                var node: plist_t?
+                try check(lockdownd_get_value(client, deviceKey, nil, &node))
+                guard let node else { throw IdeviceGatewayError(.serviceError, reason: "Missing device metadata: " + deviceKey) }
+                defer { plist_free(node) }
+                guard let value = self.getRustPlistString(node), !value.isEmpty else {
+                    throw IdeviceGatewayError(.serviceError, reason: "Invalid device metadata: " + deviceKey)
+                }
+                record[recordKey] = value
+            }
+            return try PropertyListSerialization.data(fromPropertyList: record, format: .xml, options: 0)
+        }
+    }
