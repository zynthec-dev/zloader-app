          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende einen kompatiblen externen lokalen VPN-Tunnel für Gerätedienste. zLoader prüft die Erreichbarkeit, ohne eine VPN-App zu öffnen oder zu steuern."
          }
        }
      }
    },
    "Use a compatible external local VPN tunnel, or enable the optional integrated tunnel with an eligible paid Apple developer team. No specific external VPN app is required.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
