    "Enter the password used when exporting the .p12 file from Keychain Access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Passwort ein, das beim Export der .p12-Datei aus der Schlüsselbundverwaltung verwendet wurde."
          }
        }
      }
    },
    "Choose a name and a certificate with its private key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Namen und ein Zertifikat mit seinem privaten Schlüssel."
          }
        }
      }
    },
    "Import at least one provisioning profile.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere mindestens ein Provisionierungsprofil."
          }
        }
      }
    },
    "Every selected profile must authorize this certificate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes ausgewählte Profil muss dieses Zertifikat autorisieren."
          }
        }
      }
    },
    "The certificate could not be saved securely.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat konnte nicht sicher gespeichert werden."
          }
        }
      }
    },
    "Each app and extension needs a matching profile. A wildcard profile cannot grant capabilities that Apple did not authorize.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede App und Extension benötigt ein passendes Profil. Ein Wildcard-Profil kann keine Capabilities freigeben, die Apple nicht autorisiert hat."
          }
        }
      }
    },
    "Import a PKCS#12 certificate with its private key and the Apple-signed profiles for the app and its extensions. Removing an identity here does not revoke anything in your Developer Account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere ein PKCS#12-Zertifikat mit seinem privaten Schlüssel und die von Apple signierten Profile für die App und ihre Extensions. Das Entfernen einer Identität widerruft nichts in deinem Developer-Account."
          }
        }
      }
    },
