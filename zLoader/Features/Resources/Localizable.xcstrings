          "stringUnit": {
            "state": "translated",
            "value": "Enable Background Refresh to automatically refresh apps in the background when connected to Wi-Fi. \n\nEnable Disable Idle Timeout to allow zLoader to keep your device awake during a refresh or install of any apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Hintergrund-Refresh, um Apps im Hintergrund automatisch zu aktualisieren, wenn eine WLAN-Verbindung besteht.\n\nAktiviere „Automatische Sperre verhindern“, damit zLoader dein Gerät während Refresh oder Installation wach hält."
          }
        }
      }
