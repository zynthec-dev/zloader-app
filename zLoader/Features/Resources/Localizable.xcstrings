          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende einen kompatiblen externen lokalen VPN-Tunnel oder aktiviere den optionalen integrierten Tunnel mit einem geeigneten bezahlten Apple-Entwicklerteam. Eine bestimmte externe VPN-App ist nicht erforderlich."
          }
        }
      }
    },
