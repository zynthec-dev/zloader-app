    "Signs and installs an IPA, waits for completion and returns Succeeded, Failed or Cancelled. Connect your VPN before this action and disconnect it afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs and installs an IPA, waits for completion and returns Succeeded, Failed or Cancelled. Connect your VPN before this action and disconnect it afterwards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signiert und installiert eine IPA, wartet auf den Abschluss und liefert Erfolgreich, Fehlgeschlagen oder Abgebrochen. Verbinde dein VPN vor dieser Aktion und trenne es danach."
          }
        }
      }
    },
