          }
        }
      }
    },
    "Settings could not be opened. Open Settings → Privacy & Security → Developer Mode manually. The pairing server remains active.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen konnten nicht geöffnet werden. Öffne Einstellungen → Datenschutz & Sicherheit → Entwicklermodus manuell. Der Pairing-Server bleibt aktiv."
