          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Updates unterstützen iOS %@ nicht. Aktualisiere dein Gerät auf die neueste iOS-Version, um sie zu installieren."
          }
        }
      }
    },
    "This PEM export is unencrypted. Anyone with the file can use the key. Use the certificate manager's password-protected P12 export once the matching certificate is imported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PEM export is unencrypted. Anyone with the file can use the key. Use the certificate manager's password-protected P12 export once the matching certificate is imported."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser PEM-Export ist unverschlüsselt. Jeder mit der Datei kann den Schlüssel verwenden. Verwende nach Import des passenden Zertifikats den passwortgeschützten P12-Export der Zertifikatsverwaltung."
          }
        }
      }
    },
    "This deletes this stored key and CSR. It does not revoke an Apple certificate or remove copies already attached to signing certificates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
