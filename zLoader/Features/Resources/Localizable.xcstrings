    "Tap Start to advertise this device on the local network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Start, um dieses Gerät im lokalen Netzwerk bekannt zu machen."
          }
