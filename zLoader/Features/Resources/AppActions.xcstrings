    "No active local certificate found.Import a .p12 file to sign your apps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein aktives lokales Zertifikat vorhanden. Importiere eine P12-Datei, um deine Apps zu signieren."
          }
        }
      }
    },
    "No active local certificate found.Create a new certificate or import a .p12 file to sign your apps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein aktives lokales Zertifikat vorhanden. Erstelle ein Zertifikat oder importiere eine P12-Datei, um deine Apps zu signieren."
          }
        }
      }
    },
    "The installed signing certificate has expired and cannot be activated automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat dieser Installation ist abgelaufen und kann nicht automatisch aktiviert werden."
          }
        }
      }
    },
    "Installed signing identity detected. Its matching private key is missing. Import the corresponding .p12 from your installer or Mac; this certificate will then activate automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Signierungsidentität dieser Installation wurde erkannt. Der passende private Schlüssel fehlt. Importiere die zugehörige P12-Datei aus deinem Installationsprogramm oder vom Mac. Das Zertifikat wird anschließend automatisch aktiviert."
          }
        }
      }
    }
  },
  "version": "1.0"
