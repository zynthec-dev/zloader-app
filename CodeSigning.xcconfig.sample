// Copy to CodeSigning.xcconfig (ignored by Git).
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_IDENTITY = Apple Development
// For an existing installation, use its exact host ID and App Group here.
// Do not shorten a historical team suffix when preserving its containers.
// MAIN_BUNDLE_IDENTIFIER = YOUR_EXISTING_HOST_ID
// APP_GROUP_IDENTIFIER = YOUR_EXISTING_GROUP_WITHOUT_GROUP_PREFIX
// Host/Backup/Widget/Tunnel derive their IDs from MAIN_BUNDLE_IDENTIFIER.
// Keep each target's own entitlement file; do not override it globally.
// An eligible paid team must provision host/tunnel Network Extensions and groups.
